# Vorlage für .env im Projektordner - nach .env kopieren und ausfüllen. Die .env wird nicht eingecheckt.
# Gelesen von backend/config.py (App) und mcp_servers/mailer.py, inbox.py (Mail).
# Gesetzte Umgebungsvariablen haben Vorrang vor der Datei. Leere oder auskommentierte Zeilen = nicht gesetzt.

# --- Assistent ---
# "ollama" (Standard) oder "commands" (nur feste Befehle, ohne KI)
# PDA_ASSISTANT_BACKEND=ollama
# OLLAMA_HOST=http://localhost:11434
# PDA_OLLAMA_MODEL=qwen3:8b

# --- Reise-Assistent (Einrichtung siehe README) ---
# openrouteservice (Pflicht): https://openrouteservice.org/dev/#/signup
PDA_ORS_KEY=
# DB API Marketplace, API "Timetables": https://developers.deutschebahn.com
PDA_DB_CLIENT_ID=
PDA_DB_API_KEY=
# Tankerkönig (Spritpreise): https://creativecommons.tankerkoenig.de
PDA_TANKERKOENIG_KEY=

# --- E-Mail senden (SMTP) ---
# Gmail: smtp.gmail.com, Port 587, App-Passwort unter https://myaccount.google.com/apppasswords
PDA_SMTP_HOST=smtp.gmail.com
PDA_SMTP_PORT=587
PDA_SMTP_USER=deine.adresse@gmail.com
PDA_SMTP_PASSWORD=app-passwort-hier
# PDA_MAIL_FROM=deine.adresse@gmail.com
# Nur an diese Adressen darf der Assistent schreiben (Komma-getrennt, die erste ist der Standard)
PDA_MAIL_RECIPIENTS=empfaenger@example.com

# --- E-Mail lesen (IMAP) ---
# Alles optional: Ohne Angabe wird aus smtp.xyz imap.xyz, Port 993, Login und Passwort wie oben.
# Bei Gmail muss IMAP in den Gmail-Einstellungen aktiv sein.
# PDA_IMAP_HOST=imap.gmail.com
# PDA_IMAP_PORT=993
# PDA_IMAP_USER=deine.adresse@gmail.com
# PDA_IMAP_PASSWORD=app-passwort-hier

# --- Ablage für Mail-Anhänge ---
# Standard: %APPDATA%/PersonalDigitalAgent/attachments
# PDA_ATTACHMENT_DIR=
