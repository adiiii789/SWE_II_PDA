{#- Standard-Template für das iframe.
    Aufruf: {"template": "default", "data": {...}} (siehe backend/views.py)
    Daten:
      title    str                        Überschrift
      text     str, optional              Absatz unter der Überschrift
      columns  list[str], optional        Tabellenkopf
      rows     list[list[str]], optional  Tabellenzeilen - ohne Zeilen keine Tabelle
    Die Styles werden eingebettet, weil das iframe isoliert ist (sandbox)
    und keine Dateien nachladen soll. -#}
<!DOCTYPE html>
<html lang="de">
<head>
  <meta charset="utf-8">
  <style>
{% include "theme.css" %}
{% include "view.css" %}
{% include "fonts/press-start-2p/font.css" %}
{% include "design-styles.css" %}
{% if welcome | default(false) %}{% include "robot-scene.css" %}{% endif %}
  </style>
</head>
<body{% if welcome | default(false) %} class="welcome-view"{% endif %}>
  {% if welcome | default(false) %}
  <section class="welcome">
    <div class="welcome-copy">
      <span class="welcome-eyebrow">ALLES AN EINEM ORT</span>
      <div class="sr-only"><h2>{{ title }}</h2></div>
      <h1>Mehr Überblick.<br><span class="welcome-emphasis">Mehr Raum für dich.</span></h1>
      <p>{{ text }}</p>
      <span class="welcome-note">Dein Alltag, ein bisschen leichter.</span>
    </div>
    <div class="robot-stage" aria-hidden="true">
      <div class="robot-shadow"></div>
      <div class="robot-fallback">{% include "icons/agent.svg" %}</div>
      <canvas class="robot-canvas"></canvas>
    </div>
  </section>
  {% else %}
  <h2>{{ title }}</h2>

  {% if text is defined and text %}
  <p>{{ text }}</p>
  {% endif %}

  {% if rows is defined and rows %}
  <table>
    {% if columns is defined and columns %}
    <thead>
      <tr>{% for column in columns %}<th>{{ column }}</th>{% endfor %}</tr>
    </thead>
    {% endif %}
    <tbody>
      {% for row in rows %}
      <tr>{% for cell in row %}<td>{{ cell }}</td>{% endfor %}</tr>
      {% endfor %}
    </tbody>
  </table>
  {% endif %}
  {% endif %}
  <script>{% include "theme-frame.js" %}</script>
  {% if welcome | default(false) %}
  <script>
{% include "robot-model.js" %}
{% include "robot-scene.js" %}
  </script>
  {% endif %}
</body>
</html>
